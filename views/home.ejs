<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="PoistDrive Home" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <% if (!currentUser) { %>
        <a href="/log-in">Log In</a>
        <a href="/sign-up">Sign Up</a>
    <% } else { %>
        <p>Welcome back <% currentUser %>!</p>
        <a href="/user/<%= currentUser.id %>">Your Drive</a>
        <a href="/log-out">Log out</a>
    <% } %>
</body>
</html>