<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your PoistDrive</title>
</head>
<body>
    <h1>Your PoistDrive</h1>

    <ul>
        <% folders.forEach((folder) => { %>
            <li>
                <a href="/user/<%= folder.userId %>/<%= folder.id %>"><%= folder.foldername %></a>
            </li>
        <% }) %>
    </ul>
</body>
</html>