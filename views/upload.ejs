<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Upload</title>
  </head>
  <body>
    <h1>Upload File</h1>

    <form action="/user/<%= currentUser.id %>/<%= folderId %>/upload" method="POST" enctype="multipart/form-data">
      <label for="fileUpload">Upload file: </label>
      <input type="file" id="fileUpload" name="fileUpload" />

      <button type="submit">Submit file</button>
    </form>
  </body>
</html>
