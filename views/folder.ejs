<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= foldername %></title>
</head>
<body>
    <h1><%= foldername %></h1>
    
    <a href="/user/<%= currentUser.id %>/<%= folderId %>/upload">Upload File</a>

    <ul>
        <% files.forEach((file) => { %>
            <li>
                <a href="/user/<%= currentUser.id %>/<%= folderId %>/<%= file.id %>"><%= file.filename %></a>
            </li>
        <% }) %>
    </ul>
</body>
</html>