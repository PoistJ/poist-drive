// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  folders  Folders[]
  files    Files[]
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model Folders {
  id         Int     @id @default(autoincrement())
  foldername String
  user       Users   @relation(fields: [userId], references: [id])
  userId     Int
  files      Files[]
}

model Files {
  id       Int     @id @default(autoincrement())
  filename String
  filesize Int
  filetype String
  user     Users   @relation(fields: [userId], references: [id])
  userId   Int
  folder   Folders @relation(fields: [folderId], references: [id])
  folderId Int
}

model List {
  id     Int    @id @default(autoincrement())
  handle String
}
